# ============================================
# FIXIYI â€” ENVIRONMENT EXAMPLE
# Ne JAMAIS mettre de vraies valeurs ici
# Copier vers .env et remplir localement
# ============================================

# --- Application ---
NODE_ENV=development
APP_NAME=Fixiyi
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_VERSION=v1

# --- Database ---
DATABASE_URL=mongodb://localhost:27017/fixiyi
DATABASE_TEST_URL=mongodb://localhost:27017/fixiyi_test

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
MIN_PROVIDER_AGE=18

# --- SMS Provider ---
SMS_PROVIDER=dev
SMS_PROVIDER_KEY=
SMS_PROVIDER_SENDER=

# --- Email Provider ---
EMAIL_PROVIDER=dev
EMAIL_PROVIDER_KEY=
EMAIL_PROVIDER_FROM=noreply@fixiyi.local

# --- Storage ---
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=fixiyi-dev
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET=minioadmin

# --- AI Provider ---
AI_PROVIDER=dev
AI_PROVIDER_KEY=
AI_MODEL_DEFAULT=

# --- Payment Provider ---
PAYMENT_PROVIDER=sandbox
PAYMENT_PROVIDER_KEY=

# --- Map Provider ---
MAP_PROVIDER=dev
MAP_PROVIDER_KEY=

# --- Feature Flags ---
FF_AI_ENABLED=true
FF_ONLINE_PAYMENT_ENABLED=false
FF_MOBILE_ENABLED=false

# --- Observability ---
LOG_LEVEL=debug
OTEL_ENABLED=false
