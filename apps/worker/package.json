{
  "name": "@fixiyi/worker",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsup src/main.ts --format esm --clean",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist",
    "test:coverage": "vitest run --coverage --testTimeout=30000"
  },
  "dependencies": {
    "@fixiyi/config": "workspace:*",
    "bullmq": "^6.3.8",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@fixiyi/eslint-config": "workspace:*",
    "@fixiyi/tsconfig": "workspace:*",
    "@types/node": "^22.9.4",
    "dotenv": "^18.0.1",
    "eslint": "^10.11.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
