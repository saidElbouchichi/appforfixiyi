{
  "extends": "@fixiyi/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": true,
    // `tokens.test.ts` reads tokens.css from disk to assert it mirrors
    // tokens.ts, so Node's typings must be opted into explicitly — same
    // reason as packages/ui.
    "types": ["node"]
  },
  "include": ["src"]
}
